# ── Backend .env template (self-hosted: kila kitu kwenye docker-compose) ──

# MongoDB (self-hosted kwenye docker-compose)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# Mosquitto broker (self-hosted) — docker-compose ina-generate mosquitto.passwd
# yenyewe kwenye startup kutoka hizi env vars:
MQTT_USERNAME=kvuser
MQTT_PASSWORD=KvChangeMe2026

# JWT — MUHIMU SANA: badilisha kwenye production! (openssl rand -hex 32)
JWT_SECRET=super-secret-change-me-in-production-please

# CORS — ongeza origin zote za frontend (local na deployed)
CORS_ORIGINS=http://localhost:3000

# Namba ya admin ambayo wachangiaji hulipia (mtandao wowote)
DONATION_PHONE=0763795801

# Backend inasikiliza port 8000 ndani ya container (root compose ina-expose 8080)

# ── Email (2FA/OTP) ──
# Weka hii ili code za 2FA ziende kwa EMAIL kweli. Inafanya kazi na SMTP yoyote
# (Gmail app-password, MailerSend, Resend, Zoho...) au MailerSend API.
# Bila hii, code inaandikwa kwenye backend logs tu (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Kubadilishana Vituo <no-reply@kubadilishana.go.tz>
SMTP_USE_TLS=true
# AU: MailerSend REST API (badala ya SMTP)
MAILERSEND_API_KEY=
